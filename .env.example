# Example environment variables. Copy to .env and source, or use in
# docker-compose `environment:`. Secrets should NOT go in .env; use the
# corresponding *_FILE variables with mounted secret files instead.

# Root / geofence
GEOFENCE_HOME_LAT=39.5
GEOFENCE_HOME_LON=-98.35
GEOFENCE_RADIUS_MILES=5
GEOFENCE_BUFFER_MILES=25

# OpenClaw gateway
OPENCLAW_HOOK_URL=https://gateway:18789/hooks/fire
OPENCLAW_HOOK_TOKEN=
OPENCLAW_AGENT_ID=main
OPENCLAW_CHANNEL=signal
OPENCLAW_TO=+15550100400
OPENCLAW_ACCOUNT_ID=
OPENCLAW_TIMEOUT_SECONDS=15

# Database
DB_DRIVER=sqlite
DB_DSN=
DB_SQLITE_PATH=./state.db

# Runtime
RUNTIME_EVENT_TTL_HOURS=24
RUNTIME_LOG_LEVEL=info
RUNTIME_ESCALATION_FACTOR=0.20
RUNTIME_ESCALATION_PERSIST_HOURS=24
RUNTIME_ESCALATION_COOLDOWN_MINUTES=60

# Config file (optional; path to YAML/JSON/TOML)
CONFIG_FILE=

# FIRMS provider
FIRMS_ENABLED=true
FIRMS_MAP_KEY=
FIRMS_SENSORS=VIIRS_SNPP,VIIRS_NOAA20
FIRMS_INTERVAL_SECONDS=300
FIRMS_MIN_CONFIDENCE=75
# FIRMS_API_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv
# FIRMS_AREA=24,50,-125,-66
# FIRMS_DAYS=1

# NIFC provider
NIFC_ENABLED=true
NIFC_INTERVAL_SECONDS=900
# NIFC_PERIMETER_URL=https://services3.arcgis.com/T4QMspbfLg3qTGWY/arcgis/rest/services/WFIGS_Interagency_Perimeters_Current/FeatureServer/0/query?where=1%3D1&outFields=*&f=geojson&outSR=4326

# NGFS provider (stub)
NGFS_ENABLED=false
NGFS_INTERVAL_SECONDS=300

# Secret files (take precedence over the NAME variables above).
# OPENCLAW_HOOK_TOKEN_FILE=/run/secrets/openclaw_hook_token
# FIRMS_MAP_KEY_FILE=/run/secrets/firms_map_key
